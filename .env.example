# Chat model: demo = rule-driven agent; llm = genuine model tool calling.
AGENT_MODE=demo
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=25
MAX_AGENT_STEPS=8
# PDF -> split -> embedding -> persistent Chroma. No BM25 fallback.
RETRIEVAL_MODE=vector
# demo = deterministic hashed vectors, NOT a pretrained semantic model.
# api = genuine embedding API. Changing provider/model requires ingest again.
EMBEDDING_PROVIDER=demo
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
PDF_DIR=output/pdf
CHUNK_SIZE=240
CHUNK_OVERLAP=40
RETRIEVAL_MIN_SCORE=0.10
RUNTIME_DIR=runtime
