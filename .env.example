# Chat service. Store the real API key only in .env or process environment.
AGENT_MODE=llm
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=25
MAX_AGENT_STEPS=8
# Persistent policy retrieval.
RETRIEVAL_MODE=vector
# Local Ollama embedding service. Rebuild the index after changing the model.
# For offline checks, set both AGENT_MODE and EMBEDDING_PROVIDER to demo.
EMBEDDING_PROVIDER=api
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
PDF_DIR=output/pdf
CHUNK_SIZE=240
CHUNK_OVERLAP=40
RETRIEVAL_MIN_SCORE=0.10
RUNTIME_DIR=runtime
